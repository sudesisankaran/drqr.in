DJANGO_SECRET_KEY=django-insecure-medical-healthcare-system-drqr-production-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase PostgreSQL Database URL
# Example connection strings from Supabase dashboard (Project Settings -> Database):
# Transaction Pooler (recommended for serverless):
# postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Direct connection:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# NOTE: If DATABASE_URL is left empty, a local SQLite database (db.sqlite3) will be used as fallback for development.
DATABASE_URL=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SIGNING_KEY=jwt-insecure-medical-system-signing-key-drqr-secure-2026
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
